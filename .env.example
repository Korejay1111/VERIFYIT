# Copy this file to .env and fill in your real keys.
# Do not commit .env to version control.

# Supabase configuration
SUPABASE_URL=https://your-project-url.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# AI provider configuration
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
HUGGINGFACE_API_TOKEN=your-huggingface-inference-token
GEMINI_API_KEYS=your-gemini-api-key-1,your-gemini-api-key-2
GEMINI_MODEL=gemini-3.8-flash

# Password reset email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-smtp-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
FRONTEND_BASE_URL=https://confamit.vercel.app

# JWT secret key (optional; generated automatically if not provided)
SECRET_KEY=your-secret-key
